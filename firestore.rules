rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/projects/{projectId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        return request.resource.data.keys().hasOnly(['revision','path','hash','title','updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.hash is string && request.resource.data.hash.matches('^[a-f0-9]{64}$')
          && request.resource.data.title is string && request.resource.data.title.size() <= 1000
          && request.resource.data.path is string
          && request.resource.data.path.matches('^users/' + userId + '/projects/' + projectId + '/snapshots/[a-zA-Z0-9-]+[.]json$')
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }

    // Plan configurations: readable by all clients, writes denied (server/admin only)
    match /planConfigs/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Discounts: readable by all clients, writes denied (server/admin only)
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if false;
    }

    // Subscriptions: users can only read their own subscription record, writes denied to client
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // AI Credit Periods: users can read their own period, writes denied to client
    match /aiCreditPeriods/{periodId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Append-only AI usage ledger: users can read their own usage records, writes denied to client
    match /aiUsage/{usageId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Admin audit log: strictly forbidden to direct client access
    match /adminAuditLog/{eventId} {
      allow read, write: if false;
    }

    // Plan requests are server-owned; clients cannot read or write them directly.
    match /planRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
